{
  "manifest_version": 3,
  "name": "Trust-Score — Fake Review Detector",
  "version": "1.0.1",
  "description": "Detect fake reviews, compare prices & find similar products on Amazon, Flipkart & Myntra. Shop smarter!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.myntra.com/*",
    "*://*.google.com/*",
    "*://*.google.co.in/*",
    "http://localhost:8010/*",
    "http://127.0.0.1:8010/*",
    "https://trust-score-59lg.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8010/*",
        "http://127.0.0.1:8010/*",
        "https://trust-score-59lg.onrender.com/*"
      ],
      "js": [
        "content_scripts/website_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}